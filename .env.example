# InterviewGenie configuration.
#
# Copy this file to `.env` and fill in what you have. Every value is optional:
# with nothing set, InterviewGenie runs fully offline using its own deterministic
# composer, which is enough to try the product but not good enough for a real
# interview. Add one LLM key and the quality changes completely.
#
#   cp .env.example .env

# ── the model that writes your answers ───────────────────────────────────
# "auto" (the default) uses whichever provider below has a key, and silently
# falls back to the offline composer when none do. Set it to "composer" to force
# the offline path, or "llm" to require a model.
INTERVIEWGENIE_GENERATION__BACKEND=auto

# Which provider to prefer: openai | azure | groq | together | deepseek |
# openrouter | mistral | xai | anthropic | google | ollama | vllm
INTERVIEWGENIE_GENERATION__LLM__PROVIDER=openai

# Pick ONE key. The first one found wins if you leave the provider as auto.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Model + tuning. gpt-4o-mini is the best price/quality point for this use
# case; gpt-4o or claude-sonnet if you want more depth.
INTERVIEWGENIE_GENERATION__LLM__MODEL=gpt-4o-mini
INTERVIEWGENIE_GENERATION__LLM__TEMPERATURE=0.4
INTERVIEWGENIE_GENERATION__LLM__MAX_TOKENS=220
INTERVIEWGENIE_GENERATION__MAX_WORDS=90

# ── speech to text ───────────────────────────────────────────────────────
# The live overlay can transcribe in the browser for free (Chrome/Edge), so no
# key is needed to try it. A streaming cloud STT key is far more accurate and
# works in every browser; Deepgram is the recommended one.
#
#   DEEPGRAM_API_KEY=
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   AZURE_SPEECH_KEY=
#   AZURE_SPEECH_REGION=eastus
#   IBM_SPEECH_API_KEY=
#   IBM_SPEECH_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# ── server ───────────────────────────────────────────────────────────────
INTERVIEWGENIE_HOST=0.0.0.0
INTERVIEWGENIE_PORT=8420
INTERVIEWGENIE_LOG_LEVEL=INFO

# ── live mode ────────────────────────────────────────────────────────────
# auto_answer: answer as soon as a complete question is detected, with no click.
# debounce_ms: how long to wait after the interviewer stops speaking before
#              deciding the question is finished.
# min_question_words: ignore fragments shorter than this.
# capture: mic | display
INTERVIEWGENIE_LIVE__AUTO_ANSWER=true
INTERVIEWGENIE_LIVE__DEBOUNCE_MS=350
INTERVIEWGENIE_LIVE__MIN_QUESTION_WORDS=3
INTERVIEWGENIE_LIVE__CAPTURE=mic
